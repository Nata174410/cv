---
import { experience } from '../data/cv';
import SectionHeading from './SectionHeading.astro';

// Un cargo es "actual" si su periodo sigue abierto.
const isCurrent = (period: string) => /presente|actualidad/i.test(period);
---

<section
  id="experience"
  class="border-y border-border-subtle bg-surface-bg py-section-gap md:py-28"
  aria-labelledby="experience-title"
>
  <div class="wrap">
    <SectionHeading
      index="02"
      eyebrow="Trayectoria"
      title="Trayectoria Profesional"
      id="experience-title"
    />

    <ol class="mt-14">
      {
        experience.map((job, i) => {
          const current = isCurrent(job.period);
          return (
            <li
              class:list={['tl-item md:grid md:grid-cols-[11rem_1fr] md:gap-8', { 'is-current': current }]}
              data-reveal
              style={`--reveal-delay: ${i * 90}ms`}
            >
              <!-- Fecha (columna izquierda en escritorio) -->
              <div class="hidden pt-7 text-right md:block">
                <p class="text-[13px] font-bold tracking-[0.12em] text-primary uppercase tabular-nums">
                  {job.period}
                </p>
                <p class="mt-1.5 inline-flex items-center gap-1 text-sm text-on-surface-variant">
                  <span class="material-symbols-outlined text-[16px]">location_on</span>
                  {job.location}
                </p>
              </div>

              <div class="tl-body">
                <span class="tl-dot" aria-hidden="true" />
                <article class="card card-hover p-6 md:p-8">
                  <!-- Fecha en móvil -->
                  <p class="mb-3 text-[12px] font-bold tracking-[0.12em] text-outline uppercase tabular-nums md:hidden">
                    {job.period} · {job.location}
                  </p>

                  {(current || job.badge) && (
                    <div class="mb-3 flex flex-wrap gap-2">
                      {current && (
                        <span class="inline-flex items-center gap-2 rounded-[999px] bg-data-growth/12 px-2.5 py-1 text-[12px] font-bold tracking-wide text-[#047857] dark:text-data-growth">
                          <span class="live-dot" aria-hidden="true" />
                          Actual
                        </span>
                      )}
                      {job.badge && (
                        <span class="inline-flex items-center rounded-[999px] border border-secondary/40 px-2.5 py-1 text-[12px] font-bold tracking-wide text-secondary">
                          {job.badge}
                        </span>
                      )}
                    </div>
                  )}

                  <h3 class="font-display text-[1.6rem] leading-tight font-semibold text-primary">
                    {job.title}
                  </h3>
                  <p class="mt-1 inline-flex items-center gap-1.5 font-semibold text-secondary">
                    <span class="material-symbols-outlined text-[18px]">work</span>
                    {job.company}
                  </p>

                  <ul class="ledger-list mt-6 space-y-3 text-[16.5px] leading-relaxed text-on-surface-variant">
                    {job.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </article>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
