---
import { profile, facts } from '../data/cv';
import SectionHeading from './SectionHeading.astro';

// La primera oración del resumen se destaca como entradilla.
const cut = profile.summary.indexOf('. ') + 1;
const lead = profile.summary.slice(0, cut);
const body = profile.summary.slice(cut).trim();
---

<section id="profile" class="py-section-gap md:py-28" aria-labelledby="profile-title">
  <div class="wrap">
    <SectionHeading index="01" eyebrow="Perfil" title="Perfil Profesional" id="profile-title" />

    <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-gutter">
      <div class="lg:col-span-7" data-reveal style="--reveal-delay: 100ms">
        <p class="font-display text-[clamp(1.25rem,2.1vw,1.55rem)] leading-[1.5] text-primary">
          {lead}
        </p>
        <p class="mt-6 text-lg leading-[1.75] text-on-surface-variant">{body}</p>
      </div>

      <div class="lg:col-span-5 lg:pl-8" data-reveal style="--reveal-delay: 200ms">
        <dl class="card stagger divide-y divide-dashed divide-border-subtle px-6">
          {
            facts.map((f, j) => (
              <div class="flex items-start gap-4 py-5" style={`--i: ${j}`}>
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-[10px] bg-secondary/10 text-secondary">
                  <span class="material-symbols-outlined text-[22px]">{f.icon}</span>
                </span>
                <div>
                  <dt class="text-[11px] font-bold tracking-[0.16em] text-outline uppercase">{f.label}</dt>
                  <dd class="mt-1 text-[16px] font-semibold text-primary">{f.value}</dd>
                </div>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
