---
import { contact, cvDownloads } from '../data/cv';
import SectionHeading from './SectionHeading.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const emailChannel = contact.channels.find((c) => c.href.startsWith('mailto:'));
const email = emailChannel?.href.replace('mailto:', '') ?? '';
const others = contact.channels.filter((c) => c !== emailChannel);
---

<section id="contact" class="py-section-gap md:py-28" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="contact-panel relative overflow-hidden rounded-[22px] px-6 py-12 ring-1 ring-white/10 md:px-14 md:py-16">
      <div class="relative grid gap-12 lg:grid-cols-12 lg:gap-gutter">
        <div class="lg:col-span-7">
          <SectionHeading
            index="05"
            eyebrow="Contacto"
            title="Hablemos"
            lead={contact.intro}
            id="contact-title"
            tone="inverse"
          />

          {
            email && (
              <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 120ms">
                <a
                  href={`mailto:${email}`}
                  class="group inline-flex items-center gap-3 font-display text-[clamp(1.35rem,3vw,2rem)] font-semibold break-all text-white decoration-[#7fe0de]/60 underline-offset-8 hover:underline"
                >
                  <span class="material-symbols-outlined text-[28px] text-[#7fe0de]">mail</span>
                  {email}
                </a>
                <button
                  type="button"
                  id="copy-email"
                  data-email={email}
                  class="inline-flex items-center gap-1.5 rounded-[999px] border border-white/20 px-3.5 py-1.5 text-sm font-semibold text-white/85 transition hover:border-white/50 hover:text-white"
                >
                  <span class="material-symbols-outlined text-[16px]" data-copy-icon>content_copy</span>
                  <span data-copy-label>Copiar</span>
                </button>
                <span class="sr-only" role="status" aria-live="polite" id="copy-status"></span>
              </div>
            )
          }
        </div>

        <div class="flex flex-col gap-4 lg:col-span-5 lg:justify-end" data-reveal style="--reveal-delay: 200ms">
          {
            others.map((channel) => (
              <a
                class="group flex items-center justify-between gap-4 rounded-[14px] border border-white/15 bg-white/[0.06] px-5 py-4 text-white backdrop-blur transition hover:border-white/40 hover:bg-white/10"
                href={channel.href}
                target={channel.href.startsWith('http') ? '_blank' : undefined}
                rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <span class="flex items-center gap-3 font-semibold">
                  <span class="material-symbols-outlined text-[22px] text-[#7fe0de]">{channel.icon}</span>
                  {channel.label}
                </span>
                <span class="material-symbols-outlined text-[20px] text-white/60 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-white">
                  arrow_outward
                </span>
              </a>
            ))
          }

          <div class="rounded-[14px] border border-white/15 bg-white/[0.06] p-5 backdrop-blur">
            <p class="text-[12px] font-bold tracking-[0.16em] text-white/60 uppercase">Hoja de vida</p>
            <div class="mt-3 grid grid-cols-2 gap-2">
              {
                cvDownloads.map((cv) => (
                  <a
                    class="inline-flex items-center justify-center gap-2 rounded-[10px] bg-white px-3 py-3 font-semibold text-[#00193c] transition hover:-translate-y-0.5 hover:bg-[#e6fffe]"
                    href={`${base}/${cv.file}`}
                    download
                  >
                    <span class="material-symbols-outlined text-[18px]">download</span>
                    {cv.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Copia el correo al portapapeles con confirmación visual y para lectores de pantalla.
  const btn = document.getElementById('copy-email');
  const status = document.getElementById('copy-status');
  btn?.addEventListener('click', async () => {
    const email = btn.dataset.email ?? '';
    const icon = btn.querySelector('[data-copy-icon]');
    const label = btn.querySelector('[data-copy-label]');
    try {
      await navigator.clipboard.writeText(email);
      if (icon) icon.textContent = 'check';
      if (label) label.textContent = 'Copiado';
      if (status) status.textContent = 'Correo copiado al portapapeles';
    } catch {
      if (label) label.textContent = 'No se pudo copiar';
    }
    window.setTimeout(() => {
      if (icon) icon.textContent = 'content_copy';
      if (label) label.textContent = 'Copiar';
      if (status) status.textContent = '';
    }, 2200);
  });
</script>
