---
import { profile, highlights, experience, cvDownloads, skills } from '../data/cv';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photo = `${base}/yennifer.jpg`;

// "Natalia" en la primera línea y "Daza Gómez" en cursiva en la segunda.
const [firstName, ...rest] = profile.name.split(' ');
const lastNames = rest.join(' ');

const current = experience[0];
const focus = skills.find((s) => s.title === 'Tributario') ?? skills[0];
const cvEs = cvDownloads[0];
---

<section id="home" class="relative overflow-hidden border-b border-border-subtle">
  <div class="ledger" aria-hidden="true"></div>
  <div class="glow glow-a" aria-hidden="true"></div>
  <div class="glow glow-b" aria-hidden="true"></div>
  <div class="hero-spot" aria-hidden="true"></div>

  <div class="wrap relative z-10 flex flex-col justify-center pt-14 pb-12 md:pt-20 lg:min-h-[min(calc(100svh-72px),880px)] lg:pt-16">
    <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-gutter">
      <!-- Texto -->
      <div class="lg:col-span-7">
        <p
          class="flex items-center gap-3 text-[13px] font-bold tracking-[0.18em] text-secondary uppercase"
          data-reveal
        >
          <span class="heading-rule h-px w-10 bg-current opacity-60" aria-hidden="true"></span>
          {profile.role}
        </p>

        <h1
          class="mt-6 font-display text-[clamp(3rem,8vw,6rem)] leading-[0.95] font-bold tracking-[-0.03em] text-primary"
        >
          <span class="line-mask"><span class="line-inner" style="--d: 120ms">{firstName}</span></span>
          <span class="line-mask">
            <span class="line-inner font-medium text-secondary italic" style="--d: 260ms">{lastNames}</span>
          </span>
        </h1>
        <div class="total-rule mt-6" aria-hidden="true"><span></span><span></span></div>

        <p
          class="mt-7 max-w-xl text-lg leading-relaxed text-on-surface-variant md:text-xl"
          data-reveal
          style="--reveal-delay: 200ms"
        >
          {profile.tagline}
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 300ms">
          <a
            data-magnetic
            class="group inline-flex items-center gap-2 rounded-[10px] bg-primary-container px-6 py-3.5 font-semibold text-on-primary shadow-[0_10px_24px_-12px_rgb(0_45_98/0.6)] transition hover:-translate-y-0.5 hover:brightness-110"
            href="#contact"
          >
            Contáctame
            <span
              class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            >
              arrow_outward
            </span>
          </a>
          <a
            class="inline-flex items-center gap-2 rounded-[10px] border border-border-subtle bg-surface-container-lowest/70 px-6 py-3.5 font-semibold text-primary backdrop-blur transition hover:-translate-y-0.5 hover:border-secondary"
            href={`${base}/${cvEs.file}`}
            download
          >
            <span class="material-symbols-outlined text-[18px] text-secondary">download</span>
            Hoja de vida
          </a>
          <a
            class="group inline-flex items-center gap-1.5 px-2 py-3 font-semibold text-on-surface-variant transition-colors hover:text-primary"
            href="#experience"
          >
            Ver trayectoria
            <span class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-y-0.5">
              arrow_downward
            </span>
          </a>
        </div>
      </div>

      <!-- Foto + tarjetas flotantes -->
      <div class="lg:col-span-5" data-reveal="scale" style="--reveal-delay: 200ms">
        <div class="relative mx-auto w-full max-w-[380px] lg:mr-0" data-tilt>
          <div
            class="absolute -inset-3 rotate-[4deg] rounded-[22px] border border-secondary/40"
            aria-hidden="true"
          >
          </div>
          <div
            class="absolute -inset-3 -rotate-[3deg] rounded-[22px] bg-secondary/10"
            aria-hidden="true"
          >
          </div>
          <div class="photo-frame relative overflow-hidden rounded-[18px] bg-surface-container">
            <img
              src={photo}
              alt={`Fotografía de ${profile.name}, ${profile.role}`}
              width="767"
              height="900"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-[767/900] w-full object-cover"
            />
            <div
              class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[#00193c]/35 to-transparent"
              aria-hidden="true"
            >
            </div>
          </div>

          <!-- Cargo actual -->
          <div
            class="float-card absolute -top-5 right-2 flex items-center gap-3 rounded-[12px] px-4 py-3 sm:-right-6"
          >
            <span class="live-dot" aria-hidden="true"></span>
            <span class="leading-tight">
              <span class="block text-[11px] font-bold tracking-[0.14em] text-outline uppercase">
                Cargo actual
              </span>
              <span class="block text-[15px] font-semibold text-primary">{current.title}</span>
            </span>
          </div>

          <!-- Especialidad -->
          <div
            class="float-card float-card-2 absolute -bottom-6 left-2 flex items-center gap-3 rounded-[12px] px-4 py-3 sm:-left-8"
          >
            <span class="grid h-9 w-9 place-items-center rounded-[9px] bg-secondary/12 text-secondary">
              <span class="material-symbols-outlined text-[20px]">{focus.icon}</span>
            </span>
            <span class="leading-tight">
              <span class="block text-[11px] font-bold tracking-[0.14em] text-outline uppercase">
                Especialidad
              </span>
              <span class="block text-[15px] font-semibold text-primary">{focus.title}</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Cifras clave (estilo informe anual) -->
    <dl
      class="mt-20 grid grid-cols-1 divide-y divide-border-subtle border-y border-border-subtle sm:grid-cols-3 sm:divide-x sm:divide-y-0 lg:mt-16"
      data-reveal
      style="--reveal-delay: 400ms"
    >
      {
        highlights.map((h) => (
          <div class="flex items-baseline gap-4 py-5 sm:flex-col sm:gap-1 sm:px-6 sm:first:pl-0">
            <dt class="order-2 text-[15px] leading-snug text-on-surface-variant sm:order-none">{h.label}</dt>
            <dd
              data-animate-value={h.value}
              class="order-1 font-display text-[2.1rem] leading-none font-semibold lining-nums tabular-nums text-primary sm:order-first">
              {h.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
