---
import { skills } from '../data/cv';
import SectionHeading from './SectionHeading.astro';

// Cada competencia lista sus áreas separadas por comas → se muestran como etiquetas.
const toTags = (description: string) =>
  description
    .replace(/\.$/, '')
    .split(',')
    .map((t) => t.trim())
    .filter(Boolean);
---

<section id="skills" class="py-section-gap md:py-28" aria-labelledby="skills-title">
  <div class="wrap">
    <SectionHeading index="03" eyebrow="Competencias" title="Competencias Técnicas" id="skills-title" />

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        skills.map((skill, i) => {
          const tags = toTags(skill.description);
          return (
            <div data-reveal style={`--reveal-delay: ${i * 120}ms`}>
              <article class="card card-hover group relative h-full overflow-hidden p-7 md:p-9">
                <span
                  class="pointer-events-none absolute -top-5 right-5 font-display text-[8rem] leading-none font-bold text-secondary/[0.07] lining-nums tabular-nums select-none"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div class="relative flex items-center gap-4">
                  <span class="grid h-14 w-14 place-items-center rounded-[14px] bg-primary-container text-on-primary shadow-sm transition-transform duration-300 group-hover:-rotate-6">
                    <span class="material-symbols-outlined text-[28px]">{skill.icon}</span>
                  </span>
                  <div>
                    <h3 class="font-display text-[1.75rem] leading-tight font-semibold text-primary">
                      {skill.title}
                    </h3>
                    <p class="text-sm font-semibold text-outline tabular-nums">
                      {tags.length} áreas
                    </p>
                  </div>
                </div>
                <ul class="stagger relative mt-7 flex flex-wrap gap-2" aria-label={`Áreas de ${skill.title}`}>
                  {tags.map((tag, j) => (
                    <li style={`--i: ${j}`} class="inline-flex items-center gap-1.5 rounded-[999px] border border-border-subtle bg-surface-bg px-3.5 py-1.5 text-[15px] font-medium text-on-surface transition-colors group-hover:border-secondary/40">
                      <span class="material-symbols-outlined text-[16px] text-secondary">check</span>
                      {tag}
                    </li>
                  ))}
                </ul>
              </article>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
