---
import { profile } from '../data/cv';
const year = new Date().getFullYear();
---

<footer class="border-t border-border-subtle">
  <div class="wrap flex flex-col items-center justify-between gap-4 py-8 text-sm text-on-surface-variant sm:flex-row">
    <p>
      © {year} <span class="font-semibold text-primary">{profile.name}</span> · {profile.role}
    </p>
    <a
      class="group inline-flex items-center gap-1.5 font-semibold transition-colors hover:text-primary"
      href="#home"
    >
      Volver arriba
      <span class="material-symbols-outlined text-[18px] transition-transform group-hover:-translate-y-0.5">
        arrow_upward
      </span>
    </a>
  </div>
</footer>
