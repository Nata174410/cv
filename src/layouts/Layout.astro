---
import '../styles/global.css';
import { profile, seo, contact, skills, education, certifications, facts, experience } from '../data/cv';

interface Props {
  title?: string;
  description?: string;
  // Páginas que no deben indexarse (p. ej. el 404): sin canónica ni datos estructurados.
  noindex?: boolean;
}

const { title = seo.title, description = seo.description, noindex = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// URL canónica absoluta (Astro.site + base + path)
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://Nata174410.github.io/').href;
const ogImageUrl = new URL(`${base}/${seo.ogImage}`, Astro.site ?? 'https://Nata174410.github.io/').href;
const email = contact.channels.find((c) => c.href.startsWith('mailto:'))?.href ?? '';

// Material Symbols: se descarga solo el subconjunto de iconos que usa el sitio
// (la fuente completa pesa ~1.1 MB). Google exige los nombres en orden alfabético.
// Si un componente usa un icono nuevo, agrégalo a `uiIcons`.
const uiIcons = [
  'arrow_downward', 'arrow_outward', 'arrow_upward', 'check', 'close', 'content_copy',
  'dark_mode', 'download', 'expand_more', 'light_mode', 'location_on', 'mail', 'menu',
  'verified', 'work',
];
const iconNames = [
  ...new Set([
    ...uiIcons,
    ...facts.map((f) => f.icon),
    ...skills.map((s) => s.icon),
    ...education.map((e) => e.icon),
    ...certifications.map((c) => c.icon),
    ...contact.channels.map((c) => c.icon),
  ]),
]
  .sort()
  .join(',');
const iconsHref = `https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&icon_names=${iconNames}&display=block`;

// Datos estructurados (schema.org) en un @graph: Person + ProfilePage + WebSite.
// Todo sale de cv.ts para que no se desactualice (empleador actual, formación, certificaciones).
const site = Astro.site ?? 'https://Nata174410.github.io/';
const photoUrl = new URL(`${base}/yennifer.jpg`, site).href;
const personId = `${canonical}#natalia`;
const [firstName, ...lastNames] = profile.name.split(' ');

// Empleadores actuales: cargos con periodo abierto que no sean práctica independiente.
const currentJobs = experience.filter((j) => /presente|actualidad/i.test(j.period) && !j.badge);
// Instituciones de formación sin repetir.
const schools = [...new Set(education.map((e) => e.institution))];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: profile.name,
      givenName: firstName,
      familyName: lastNames.join(' '),
      alternateName: seo.alternateName,
      jobTitle: profile.role,
      description: seo.description,
      image: photoUrl,
      url: canonical,
      email,
      sameAs: seo.sameAs,
      knowsLanguage: 'es',
      knowsAbout: [
        'Contabilidad',
        'Declaración de renta de personas naturales',
        'IVA',
        'Retención en la fuente',
        'Información exógena',
        'NIIF / IFRS',
        'Power BI',
        'Análisis de datos',
      ],
      worksFor: currentJobs.map((j) => ({ '@type': 'Organization', name: j.company })),
      hasOccupation: {
        '@type': 'Occupation',
        name: profile.role,
        occupationLocation: { '@type': 'City', name: 'Bogotá' },
      },
      alumniOf: schools.map((name) => ({ '@type': 'EducationalOrganization', name })),
      hasCredential: certifications.map((c) => ({
        '@type': 'EducationalOccupationalCredential',
        name: c.title,
        credentialCategory: 'certificate',
        recognizedBy: { '@type': 'Organization', name: c.institution },
      })),
      address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressCountry: 'CO' },
    },
    {
      // Google exige `mainEntity` en ProfilePage.
      '@type': 'ProfilePage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: seo.title,
      mainEntity: { '@id': personId },
      dateModified: new Date().toISOString(),
      inLanguage: 'es-CO',
    },
    {
      '@type': 'WebSite',
      '@id': `${canonical}#website`,
      url: canonical,
      name: profile.name,
      alternateName: seo.alternateName,
      inLanguage: 'es-CO',
    },
  ],
};

// Se escapan "<" y los separadores de línea U+2028/U+2029 para que ningún valor pueda cerrar el <script> ni romper el JSON-LD.
const structuredDataJson = JSON.stringify(structuredData)
  .replace(/</g, '\\u003c')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
---

<!doctype html>
<html class="scroll-smooth" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta name="theme-color" content="#f8f9ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1322" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <!-- Tema: se fija antes de pintar para evitar el parpadeo (preferencia guardada o la del sistema) -->
    <script is:inline>
      (() => {
        const sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        let theme = sys;
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') theme = saved;
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {!noindex && <link rel="canonical" href={canonical} />}

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp) -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    <meta property="profile:first_name" content={firstName} />
    <meta property="profile:last_name" content={lastNames.join(' ')} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${profile.name} — ${profile.role}`} />

    <!-- Iconos / PWA -->
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />

    <!-- Datos estructurados -->
    {!noindex && <script type="application/ld+json" set:html={structuredDataJson} />}

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap"
      rel="stylesheet"
    />
    <link href={iconsHref} rel="stylesheet" />
  </head>
  <body class="bg-background font-sans text-on-surface antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-[8px] focus:bg-primary-container focus:px-4 focus:py-2 focus:text-on-primary"
    >
      Saltar al contenido
    </a>
    <slot />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
